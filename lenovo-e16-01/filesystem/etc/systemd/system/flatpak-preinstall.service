[Unit]
Description=Install Flatpaks declared by the operating system
Wants=network-online.target
After=network-online.target
ConditionPathExists=/usr/bin/flatpak
ConditionPathExists=/etc/flatpak/preinstall.d
ConditionPathExists=/etc/lenovo-e16-01/rebased
ConditionPathExists=!/etc/lenovo-e16-01/flatpaks-preinstalled

[Service]
Type=oneshot
ExecStartPre=/usr/bin/flatpak remote-modify --system --collection-id=org.flathub.Stable flathub
ExecStart=/usr/bin/dbus-run-session -- /usr/bin/flatpak preinstall --system --noninteractive --assumeyes
ExecStartPost=/usr/bin/touch /etc/lenovo-e16-01/flatpaks-preinstalled

[Install]
WantedBy=multi-user.target
