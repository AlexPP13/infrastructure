[Unit]
Description=Rebase to the as13-ws OCI image
Requires=hardware-initramfs.service
Wants=network-online.target
After=network-online.target hardware-initramfs.service
ConditionPathExists=!/etc/as13-ws/rebased

[Service]
Type=oneshot
#ExecStart=/usr/bin/rpm-ostree rebase ostree-unverified-registry:13.0.0.1:5000/as13-ws:latest
#ExecStart=/usr/bin/rpm-ostree rebase ostree-unverified-registry:13.0.0.235:5000/as13-ws:latest
ExecStart=/usr/bin/rpm-ostree rebase ostree-unverified-registry:ghcr.io/alexstorm1313/as13-ws:latest
ExecStart=/usr/bin/install --directory --mode=0755 /etc/as13-ws
ExecStart=/usr/bin/touch /etc/as13-ws/rebased
ExecStart=/usr/bin/systemctl reboot

[Install]
WantedBy=multi-user.target
