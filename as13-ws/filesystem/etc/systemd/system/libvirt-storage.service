[Unit]
Description=Create the LVM volume group for libvirt storage
ConditionPathExists=!/etc/as13-ws/libvirt-storage-created
# The logical storage pool must not be discovered before its backing VG exists.
Wants=virtstoraged.service
Before=virtstoraged.service

[Service]
Type=oneshot
ExecStart=/usr/bin/install --directory --mode=0755 /etc/as13-ws
ExecStart=/usr/bin/bash -ceu 'pv=/dev/mapper/luks-libvirt; vg=libvirt; if ! /usr/sbin/vgs "$vg" >/dev/null 2>&1; then if ! /usr/sbin/pvs "$pv" >/dev/null 2>&1; then /usr/sbin/pvcreate --yes "$pv"; fi; /usr/sbin/vgcreate "$vg" "$pv"; fi'
ExecStart=/usr/bin/touch /etc/as13-ws/libvirt-storage-created

[Install]
WantedBy=multi-user.target
